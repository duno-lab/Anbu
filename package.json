    "type": "module",
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/jwt": "^10.2.2",
        "dotenv": "^18.0.1",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.5",
        "firebase-admin": "^14.4.0",
        "jose": "^6.2.12",
        "mysql2": "^3.24.4",
